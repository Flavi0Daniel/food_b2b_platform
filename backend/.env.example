# Servidor
PORT=3000
NODE_ENV=development
# Nº de proxies confiáveis à frente da API (ex: 1 se estiver atrás de Nginx). Necessário para o rate limit ver o IP real.
TRUST_PROXY=0

# Base de Dados (MySQL)
# Recomendado: criar um utilizador dedicado com permissões apenas sobre esta base (não usar root em produção)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=food_b2b_platform

# JWT
JWT_ACCESS_SECRET=troca_este_valor_em_producao
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troca_este_outro_valor_em_producao
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# URL do frontend (usado para montar o link de recuperação de senha enviado por email)
FRONTEND_URL=http://localhost:4200

# Uploads (comprovativos de pagamento e POD). Guardados fora de qualquer pasta pública.
UPLOAD_DIR=uploads

# SMTP (notificações por email). Opcional: se SMTP_HOST ficar vazio, os emails ficam em fila
# na tabela email_outbox sem serem enviados — útil em desenvolvimento sem servidor de email à mão.
# Exemplo com Gmail (requer "palavra-passe de aplicação", não a senha normal da conta):
#   SMTP_HOST=smtp.gmail.com / SMTP_PORT=587 / SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Plataforma B2B Alimentar
MAIL_FROM_EMAIL=no-reply@plataforma.ao
