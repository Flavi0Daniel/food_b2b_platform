{
  "info": {
    "name": "Food B2B Platform — Smoke Test (fluxo completo)",
    "description": "Percorre o fluxo de ponta a ponta: catálogo -> fornecedor/transportadora -> cliente -> encomenda -> pagamento -> aprovação -> logística -> entrega -> dashboard.\n\nCorre pasta a pasta, de cima para baixo (ou 'Run collection'). Cada pedido guarda os IDs/tokens de que precisa nas Collection Variables, para o próximo pedido usar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Configuração",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Preenche as Collection Variables 'adminEmail' e 'adminPassword' com a conta criada via `npm run create-admin` antes de correr esta coleção.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 2xx', () => pm.response.code >= 200 && pm.response.code < 300);",
                  "pm.collectionVariables.set('adminAccessToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        }
      ],
      "description": "Pré-requisito: o servidor tem de estar a correr e já deve existir uma conta ADMIN (ver `npm run create-admin` no README)."
    },
    {
      "name": "1. Catálogo",
      "item": [
        {
          "name": "Admin cria categoria",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Categoria Teste {{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 2xx', () => pm.response.code >= 200 && pm.response.code < 300);",
                  "pm.collectionVariables.set('categoryId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin cria produto",
          "request": {
            "method": "POST",
            "header": [],
