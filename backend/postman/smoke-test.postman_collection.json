              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 2xx', () => pm.response.code >= 200 && pm.response.code < 300);"
                ]
              }
            }
          ]
        }
      ],
      "description": ""
    },
