              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 2xx', () => pm.response.code >= 200 && pm.response.code < 300);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin aprova a encomenda (gera PO + guia)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "approve"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignments\": [\n    {\n      \"orderItemId\": {{orderItemId}},\n      \"supplierId\": {{supplierId}}\n    }\n  ],\n  \"carrierId\": {{carrierId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 2xx', () => pm.response.code >= 200 && pm.response.code < 300);",
                  "pm.collectionVariables.set('poId', pm.response.json().data.purchaseOrders[0].id);",
                  "pm.collectionVariables.set('shipmentId', pm.response.json().data.shipments[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "(Informativo) Admin consulta a encomenda após aprovação",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
