              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "Nota: categoryId é injetado como número pelo Postman; o Zod aceita number diretamente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"name\": \"Produto Teste\",\n  \"baseUnit\": \"KG\",\n  \"sellPrice\": 1500\n}",
