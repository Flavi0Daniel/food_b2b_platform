              "raw": "{{baseUrl}}/products/{{productId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "availability"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 2xx', () => pm.response.code >= 200 && pm.response.code < 300);"
                ]
              }
            }
          ]
        }
      ],
      "description": ""
    },
