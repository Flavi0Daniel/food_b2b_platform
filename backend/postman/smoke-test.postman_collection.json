    {
      "name": "4. Encomenda e Pagamento",
      "item": [
        {
          "name": "Cliente cria encomenda",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deliveryAddressId\": {{deliveryAddressId}},\n  \"requestedDeliveryDate\": \"{{deliveryDate}}\",\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": 5\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('deliveryDate', new Date(Date.now() + 86400000).toISOString().slice(0,10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 2xx', () => pm.response.code >= 200 && pm.response.code < 300);",
                  "pm.collectionVariables.set('orderId', pm.response.json().data.id);",
                  "pm.collectionVariables.set('orderItemId', pm.response.json().data.items[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cliente submete comprovativo de pagamento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            },
            "description": "Sem upload de ficheiro: a transactionRef já satisfaz o schema (proof OU transactionRef).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "orderId",
                  "value": "{{orderId}}",
                  "type": "text"
                },
                {
                  "key": "method",
                  "value": "MULTICAIXA_EXPRESS",
                  "type": "text"
                },
                {
                  "key": "transactionRef",
                  "value": "TESTE{{$timestamp}}",
                  "type": "text"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clientAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 2xx', () => pm.response.code >= 200 && pm.response.code < 300);",
                  "pm.collectionVariables.set('paymentId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin valida o pagamento",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}",
                "validate"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
